{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": ["apps/*/src/main.{ts,tsx}", "packages/*/src/index.{ts,tsx}"],
  "workspaces": {
    "patterns": ["apps/*", "packages/*"]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.data/**",
    "**/.worktrees/**",
    "**/playwright-report/**",
    "**/test-results/**"
  ]
}
